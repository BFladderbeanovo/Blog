---
/**
 * FrameLines — Decorative framing device
 * Adds thin border lines with corner registration marks
 */
interface Props {
  inset?: string;
}
const { inset = '16px' } = Astro.props;
---
<div class="frame-lines" style={`--frame-inset: ${inset};`} aria-hidden="true">
  <span class="frame-edge frame-top"></span>
  <span class="frame-edge frame-right"></span>
  <span class="frame-edge frame-bottom"></span>
  <span class="frame-edge frame-left"></span>
  <!-- Corner registration marks -->
  <span class="reg-mark reg-tl"></span>
  <span class="reg-mark reg-tr"></span>
  <span class="reg-mark reg-bl"></span>
  <span class="reg-mark reg-br"></span>
</div>

<style>
  .frame-lines {
    position: absolute;
    inset: var(--frame-inset);
    pointer-events: none;
    z-index: var(--z-base);
  }

  .frame-edge {
    position: absolute;
    background: var(--border);
  }
  .frame-top    { top: 0; left: 24px; right: 24px; height: 1px; }
  .frame-right  { right: 0; top: 24px; bottom: 24px; width: 1px; }
  .frame-bottom { bottom: 0; left: 24px; right: 24px; height: 1px; }
  .frame-left   { left: 0; top: 24px; bottom: 24px; width: 1px; }

  .reg-mark {
    position: absolute;
    width: 8px;
    height: 8px;
  }
  .reg-mark::before,
  .reg-mark::after {
    content: '';
    position: absolute;
    background: var(--text-tertiary);
  }
  .reg-mark::before {
    width: 100%;
    height: 1px;
    top: 50%;
  }
  .reg-mark::after {
    height: 100%;
    width: 1px;
    left: 50%;
  }
  .reg-tl { top: -4px; left: -4px; }
  .reg-tr { top: -4px; right: -4px; }
  .reg-bl { bottom: -4px; left: -4px; }
  .reg-br { bottom: -4px; right: -4px; }

  @media (max-width: 768px) {
    .frame-lines { display: none; }
  }
</style>
