---
const bryanToday = new Date();
---

<footer class="site-footer">
  <div class="footer-strip" aria-hidden="true">
    <span>BF / DIGITAL GARDEN / NOTES</span>
    <span>BF / DIGITAL GARDEN / NOTES</span>
    <span>BF / DIGITAL GARDEN / NOTES</span>
    <span>BF / DIGITAL GARDEN / NOTES</span>
  </div>

  <div class="footer-main">
    <div class="footer-left">
      <div class="social-links">
        <a href="https://github.com/BFladderbeanawa" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <span class="sr-only">GitHub</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0-2-1.5-3-1.5-3-1.5-.3 1.15-.3 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
        </a>
        <a href="https://space.bilibili.com/499560971" target="_blank" rel="noopener noreferrer" aria-label="Bilibili">
          <span class="sr-only">Bilibili</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>
        </a>
      </div>
      <p class="copyright">&copy; {bryanToday.getFullYear()} BFladderbean. <a href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">MIT License</a>.</p>
    </div>

    <button id="status-trigger" class="status-trigger" aria-label="Show status">
      <span class="pulse-dot"></span>
      <span>Live Status</span>
    </button>
  </div>

  <div id="status-overlay" class="status-overlay"></div>
  <aside id="status-drawer" class="status-drawer" aria-hidden="true">
    <div class="drawer-header">
      <span class="axis-label">Current Signal</span>
      <button id="close-drawer" class="close-btn" aria-label="Close">X</button>
    </div>
    <div class="status-card-inner">
      <h3 id="status-app" class="status-app">Loading...</h3>
      <p class="status-subtitle">Device and presence telemetry</p>
      <div class="status-items">
        <div class="status-item"><span>Battery</span><strong id="status-battery">--</strong></div>
        <div class="status-item"><span>Network</span><strong id="status-wifi">--</strong></div>
        <div class="status-item"><span>City</span><strong id="status-city">--</strong></div>
        <div class="status-item"><span>Model</span><strong id="status-model">--</strong></div>
      </div>
    </div>
  </aside>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-header);
    flex: 0 0 auto;
    border-top: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
  }

  .footer-strip {
    display: flex;
    width: 100%;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    background: var(--text-primary);
    color: var(--canvas);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 2.2rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .footer-strip span {
    flex: 0 0 auto;
    padding: 0.45rem 1.2rem 0.65rem;
  }

  .footer-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: 0.85rem 1rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .social-links {
    display: flex;
    border: 1px solid var(--border);
  }

  .social-links a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-right: 1px solid var(--border);
  }

  .social-links a:last-child {
    border-right: 0;
  }

  .social-links a:hover,
  .status-trigger:hover,
  .close-btn:hover {
    background: var(--text-primary);
    color: var(--canvas);
  }

  .copyright {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.72rem 1rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--accent-green);
  }

  .status-overlay {
    position: fixed;
    inset: 0;
    z-index: 998;
    visibility: hidden;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-editorial);
  }

  .status-overlay.active {
    visibility: visible;
    opacity: 1;
  }

  .status-drawer {
    position: fixed;
    top: 0;
    right: -31rem;
    z-index: 999;
    width: min(30rem, 100vw);
    height: 100vh;
    padding: var(--space-lg);
    border-left: var(--frame) solid var(--border);
    background: var(--surface);
    transition: right var(--duration-base) var(--ease-editorial);
  }

  .status-drawer.active {
    right: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .close-btn {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .status-app {
    margin-top: var(--space-xl);
    font-size: clamp(2.5rem, 8vw, 5rem);
  }

  .status-subtitle {
    margin: 0.5rem 0 var(--space-lg);
  }

  .status-items {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .status-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .footer-main,
    .footer-left {
      align-items: stretch;
      flex-direction: column;
    }

    .status-trigger {
      justify-content: center;
    }

    .status-drawer {
      right: -105vw;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const bryanTrigger = document.getElementById('status-trigger');
    const bryanDrawer = document.getElementById('status-drawer');
    const bryanOverlay = document.getElementById('status-overlay');
    const bryanCloseBtn = document.getElementById('close-drawer');

    function bryanOpenDrawer() {
      bryanDrawer?.classList.add('active');
      bryanOverlay?.classList.add('active');
    }

    function bryanCloseDrawerAction() {
      bryanDrawer?.classList.remove('active');
      bryanOverlay?.classList.remove('active');
    }

    bryanTrigger?.addEventListener('click', bryanOpenDrawer);
    bryanCloseBtn?.addEventListener('click', bryanCloseDrawerAction);
    bryanOverlay?.addEventListener('click', bryanCloseDrawerAction);

    fetch('https://status-api.fannbryan.workers.dev/')
      .then((bryanResponse) => bryanResponse.json())
      .then((bryanData) => {
        const bryanAppEl = document.getElementById('status-app');
        if (!bryanAppEl) return;

        bryanAppEl.textContent = bryanData.app || 'Online';
        const bryanBattery = bryanData['battery '] || bryanData.battery || '--';
        document.getElementById('status-battery').textContent = String(bryanBattery).trim() + '%';
        const bryanIsConnected = bryanData.wifi && bryanData.wifi !== 'Not Connected';
        document.getElementById('status-wifi').textContent = bryanIsConnected ? 'Connected' : 'Offline';
        document.getElementById('status-city').textContent = bryanData.city || '--';
        document.getElementById('status-model').textContent = bryanData.model || '--';
      })
      .catch(() => {
        const bryanAppEl = document.getElementById('status-app');
        if (bryanAppEl) bryanAppEl.textContent = 'Offline';
      });
  });
</script>
