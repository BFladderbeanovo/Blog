---
/**
 * ScanLine — Subtle animated scanning line
 * A slow-moving horizontal line that scrolls down the viewport
 */
---
<div class="scan-line-container" aria-hidden="true">
  <div class="scan-line"></div>
</div>

<style>
  .scan-line-container {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-grid);
    overflow: hidden;
  }

  .scan-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--accent-gold-dim) 20%,
      var(--accent-gold) 50%,
      var(--accent-gold-dim) 80%,
      transparent 100%
    );
    opacity: 0.15;
    animation: scanDown 12s linear infinite;
  }

  @keyframes scanDown {
    0%   { top: -2px; }
    100% { top: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-line { animation: none; display: none; }
  }
</style>
