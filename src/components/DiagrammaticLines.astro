---
/**
 * DiagrammaticLines — Direction B route-line decoration
 * Diagonal connector system: inspired by 组合3.svg asset
 * White lines on a surface, used as compositional background guides
 */
interface Props {
  inset?: string;
  variant?: 'full' | 'corner' | 'route';
}
const { inset = '10px', variant = 'full' } = Astro.props;
---
<div class={`diagram-lines variant-${variant}`} style={`--inset: ${inset};`} aria-hidden="true">
    <!-- Corner registration marks -->
    <span class="reg tl"></span>
    <span class="reg tr"></span>
    <span class="reg bl"></span>
    <span class="reg br"></span>

    <!-- Route lines (inline SVG, adapted from 组合3.svg) -->
    {variant === 'full' && (
        <svg class="route-svg" viewBox="0 0 368 67" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" aria-hidden="true">
            <path opacity="0.35" d="M0 2.5H218L258 56.5H367.5" stroke="var(--accent-cyan)"/>
            <path opacity="0.2"  d="M20 12H93L133 65.5H367.5" stroke="var(--accent-cyan)"/>
            <path opacity="0.25" d="M1 13L14.0559 30H91" stroke="var(--accent-cyan)"/>
            <rect x="144" y="64" width="84" height="2" fill="var(--accent-cyan)" opacity="0.4"/>
            <rect x="164" y="0"  width="24" height="4" fill="var(--accent-cyan)" opacity="0.5"/>
            <rect x="71"  y="0"  width="3"  height="4" fill="var(--accent-cyan)" opacity="0.5"/>
        </svg>
    )}
    {variant === 'corner' && (
        <svg class="route-svg corner-svg" viewBox="0 0 167 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M166.854 0.5H42.8535L0.353546 43" stroke="var(--accent-cyan)" opacity="0.35"/>
        </svg>
    )}
</div>

<style>
    .diagram-lines {
        position: absolute;
        top: var(--inset);
        left: var(--inset);
        right: var(--inset);
        bottom: var(--inset);
        pointer-events: none;
        z-index: var(--z-base);
        overflow: hidden;
    }

    /* ── Route SVG fills the container ── */
    .route-svg {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 80px;
    }
    .corner-svg {
        top: 0;
        right: 0;
        bottom: auto;
        left: auto;
        width: 50%;
        height: auto;
    }

    /* ── Corner registration marks ── */
    .reg {
        position: absolute;
        width: 12px;
        height: 12px;
    }
    .reg::before, .reg::after {
        content: '';
        position: absolute;
        background: var(--accent-cyan);
    }
    .reg::before { width: 100%; height: 1px; top: 50%; }
    .reg::after  { height: 100%; width: 1px; left: 50%; }

    .tl { top: -6px;    left: -6px; }
    .tr { top: -6px;    right: -6px; }
    .bl { bottom: -6px; left: -6px; }
    .br { bottom: -6px; right: -6px; }

    @media (max-width: 768px) {
        .route-svg { display: none; }
    }
</style>
