---
import Layout from '../../layouts/Layout.astro';
import BlogNav from '../../components/BlogNav.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const categories = [...new Set(allPosts.map((post) => post.data.category).filter(Boolean))];
const categoryCounts = categories.reduce((acc, category) => {
  if (!category) return acc;
  acc[category] = allPosts.filter((p) => p.data.category === category).length;
  return acc;
}, {} as Record<string, number>);
---

<Layout title="Categories">
  <main class="page-shell">
    <BlogNav />
    <section>
      <h1 class="page-title">Categories</h1>
      <div class="category-grid">
        {categories.map((category) => (
          <a href={`/category/${category}/`} class="category-card">
            <span class="axis-label">Category</span>
            <h3>{category}</h3>
            <span class="count">{categoryCounts[category as string]} records</span>
          </a>
        ))}
        {categories.length === 0 && <p>No categories yet.</p>}
      </div>
    </section>
  </main>
</Layout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-lg);
  }

  .category-card {
    min-height: 16rem;
    display: grid;
    align-content: space-between;
    padding: var(--space-lg);
    border: var(--frame) solid var(--border);
    background: var(--surface);
  }

  .category-card:nth-child(3n + 1) { background: var(--accent-lemon); }
  .category-card:nth-child(3n + 2) { background: var(--accent-sky); }
  .category-card:nth-child(3n + 3) { background: var(--accent-orange); }

  .category-card h3 {
    color: #111;
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .category-card .axis-label,
  .category-card .count {
    color: #111;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
