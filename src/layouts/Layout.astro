---
import { bryanClientRouter } from 'astro:transitions';
import bryanHeader from '../components/Header.astro';
import bryanFooter from '../components/Footer.astro';
import bryanPageTransition from '../components/PageTransition.astro';
import bryanThemeSwitcher from '../components/ThemeSwitcher.astro';
import bryanBackgroundParticles from '../components/BackgroundParticles.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface bryanProps {
  bryanTitle?: string;
  bryanDescription?: string;
}

const { bryanTitle = "BF's Digital Garden", bryanDescription = 'Notes, experiments, and field reports.' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="modern">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={bryanDescription} />

    <script is:inline>
      (function () {
        const bryanGetTheme = () => {
          const bryanStored = localStorage.getItem('site-theme');
          if (bryanStored === 'modern' || bryanStored === 'nord') return bryanStored;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'nord' : 'modern';
        };

        const bryanApplyTheme = () => {
          document.documentElement.setAttribute('data-theme', bryanGetTheme());
        };

        bryanApplyTheme();
        document.addEventListener('astro:after-swap', bryanApplyTheme);
      })();
    </script>

    <bryanClientRouter />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={bryanTitle} />
    <meta property="og:description" content={bryanDescription} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={bryanTitle} />
    <meta property="twitter:description" content={bryanDescription} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{bryanTitle}</title>
  </head>
  <body>
    <bryanBackgroundParticles />
    <bryanPageTransition />
    <bryanHeader />
    <div id="scroll-container" class="scroll-container">
      <slot />
    </div>
    <bryanThemeSwitcher />
    <bryanFooter />
  </body>
</html>
